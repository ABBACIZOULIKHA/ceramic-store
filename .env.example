# Clé API Gemini (Nano Banana) — https://aistudio.google.com/
# ⚠️ En appelant Gemini directement depuis le navigateur, cette clé est visible
# dans le code source de la page. À réserver aux projets démo/personnels ;
# en production, préférez un proxy serveur (ex: Supabase Edge Function).
# REACT_APP_GEMINI_API_KEY=your_key_here

# Optionnel : modèle image à utiliser (défaut: gemini-3.1-flash-image).
# ⚠️ La génération d'images Gemini n'est PAS incluse dans le free tier :
# il faut activer la facturation (pay-as-you-go) sur le projet de la clé.
# REACT_APP_GEMINI_MODEL=gemini-3.1-flash-image

# Clé API NVIDIA (Qwen-Image-Edit) — https://build.nvidia.com/
REACT_APP_NVIDIA_API_KEY=your_nvidia_api_key_here

# Modèle NVIDIA à utiliser (défaut: qwen-image-edit-nvpcb-ovsl2sl)
# REACT_APP_NVIDIA_MODEL=qwen-image-edit-nvpcb-ovsl2sl

# Chatbot (modèle texte — inclus dans le free tier, contrairement aux modèles image)
# REACT_APP_GEMINI_CHAT_MODEL=gemini-3.6-flash
